{
  "version": 2,
  "buildCommand": "./build.sh",
  "devCommand": "python manage.py runserver",
  "installCommand": "pip install -r requirements.txt",
  "framework": "django",
  "regions": ["iad1"],
  "functions": {
    "socialmedia_backend/wsgi.py": {
      "maxDuration": 30,
      "runtime": "python3.9"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "socialmedia_backend/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "socialmedia_backend.settings"
  }
}