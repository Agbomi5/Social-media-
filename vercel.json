{
  "version": 2,
  "builds": [
    {
      "src": "build.sh",
      "use": "@vercel/bash"
    },
    {
      "src": "socialmedia_backend/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "socialmedia_backend/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "socialmedia_backend.settings"
  }
}