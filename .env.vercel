# Vercel Deployment Environment Variables
# Copy these to Vercel Dashboard → Settings → Environment Variables

SECRET_KEY=jx90%i^o5-d!+#ly#045s%1ji+pirx%fhb!etxk@ob+4=x9&bp
DEBUG=False
ALLOWED_HOSTS=.vercel.app,.now.sh,vordi.vercel.app

# DATABASE_URL - REPLACE WITH YOUR ACTUAL POSTGRESQL URL
# Example formats:
# Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
# Neon: postgresql://[user]:[password]@[endpoint]/[dbname]?sslmode=require
# Railway: postgresql://postgres:[password]@[host]:[port]/railway?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Vercel domain configuration
CORS_ALLOWED_ORIGINS=https://vordi.vercel.app
CSRF_TRUSTED_ORIGINS=https://vordi.vercel.app

# Optional: If you have a custom domain, add it too
# CORS_ALLOWED_ORIGINS=https://vordi.vercel.app,https://your-custom-domain.com
# CSRF_TRUSTED_ORIGINS=https://vordi.vercel.app,https://your-custom-domain.com

# Media storage (optional - for production file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1