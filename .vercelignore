media/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.local
.env.production.local

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Test
.coverage
htmlcov/
.pytest_cache/